spring.application.name=ThuVienApplication

spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration

spring.datasource.name=computer
# Thêm cấu hình DataSource chuẩn của Spring Boot
